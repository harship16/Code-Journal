{
  "name": "diary-person-reference",
  "displayName": "Diary Person Reference",
  "description": "Custom language support for diary entries with person references",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:diary-entry",
    "onLanguage:diary-person",
    "onLanguage:diary-tag"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "diary-entry",
        "aliases": [
          "Diary Entry",
          "diary-entry"
        ],
        "extensions": [
          ".entry"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "diary-person",
        "aliases": [
          "Diary Person",
          "diary-person"
        ],
        "extensions": [
          ".person"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "diary-tag",
        "aliases": [
          "Diary Tag",
          "diary-tag"
        ],
        "extensions": [
          ".tag"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "diary-entry",
        "scopeName": "source.entry",
        "path": "./syntaxes/entry.tmLanguage.json"
      },
      {
        "language": "diary-person",
        "scopeName": "source.person",
        "path": "./syntaxes/person.tmLanguage.json"
      },
      {
        "language": "diary-tag",
        "scopeName": "source.tag",
        "path": "./syntaxes/tag.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  }
}

