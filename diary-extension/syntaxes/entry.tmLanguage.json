{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Diary Entry",
  "patterns": [
    {
      "name": "entity.name.person",
      "match": "\\$[A-Za-z][A-Za-z0-9_]*"
    },
    {
      "name": "entity.name.tag",
      "match": "#[A-Za-z][A-Za-z0-9_]*"
    }
  ],
  "scopeName": "source.entry"
}

